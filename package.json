{
  "name": "n8n-nodes-listmonk-community",
  "version": "1.2.0",
  "description": "n8n community node for Listmonk, kept in sync with current n8n and listmonk releases (fork of n8n-nodes-listmonk)",
  "keywords": [
    "n8n-community-node-package",
    "listmonk",
    "email"
  ],
  "license": "(MIT AND Apache-2.0)",
  "homepage": "https://github.com/Djancyp/listmonk-n8n",
  "author": {
    "name": "djan",
    "email": "youcyprus@gmail.com"
  },
  "contributors": [
    {
      "name": "Lucas Sovre",
      "email": "lucas.sovre@proton.me"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Djancyp/listmonk-n8n.git"
  },
  "bugs": {
    "url": "https://github.com/Djancyp/listmonk-n8n/issues"
  },
  "main": "index.js",
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ListmonkApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Listmonk/Listmonk.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.16.7",
    "gulp": "^4.0.2",
    "n8n-workflow": "^2.16.0",
    "prettier": "^2.7.1",
    "typescript": "~5.8"
  }
}
